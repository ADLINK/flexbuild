+
+&pcie1 {
+	assigned-clocks =<&scmi_clk IMX95_CLK_HSIOPLL_VCO>,
+			 <&scmi_clk IMX95_CLK_HSIOPLL>,
+			 <&scmi_clk IMX95_CLK_HSIOPCIEAUX>;
