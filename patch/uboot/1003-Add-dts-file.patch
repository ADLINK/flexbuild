+	reg = <1>;
+	/delete-property/ reset-gpios;
+};
+
+#if 0
+&netc_emdio {
+	ethphy1: ethernet-phy@7 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <7>;
